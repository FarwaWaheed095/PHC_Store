rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection: Allow anyone to create an order, allow read/update
    match /orders/{orderId} {
      allow read, create, update: if true;
    }
    
    // Appointments collection: Allow anyone to book consultation
    match /appointments/{appointmentId} {
      allow read, create, update: if true;
    }
    
    // Prescriptions: Allow submission and reading
    match /prescriptions/{prescriptionId} {
      allow read, create, update: if true;
    }
    
    // Reviews: Allow public reading and submitting verified reviews
    match /reviews/{reviewId} {
      allow read, create, update: if true;
    }
    
    // Clinic settings: Public read, update allowed
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
